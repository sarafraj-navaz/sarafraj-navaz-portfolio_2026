VITE_EMAILJS_SERVICE_ID=service_lrt53la
VITE_EMAILJS_TEMPLATE_ID=template_zf861ov
VITE_EMAILJS_PUBLIC_KEY=QJ5WzFhRTjvLz_Hcd

# Paste your GA4 Measurement ID here if you'd rather not hardcode it in analytics.js
VITE_GA_MEASUREMENT_ID=

# Firebase — powers the /admin dashboard (live analytics, project CRUD)
# and public skill endorsements. Create a free project at
# https://console.firebase.google.com, enable Firestore + Authentication
# (Email/Password provider), then paste your web app config below.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Calendly — powers the "Book a Call" section.
# e.g. https://calendly.com/your-handle/intro-call
VITE_CALENDLY_URL=

# Cal.com — free alternative to Calendly, no time limit for solo users.
# Takes priority over VITE_CALENDLY_URL if both are set.
# e.g. https://cal.com/your-handle/intro-call
VITE_CALCOM_URL=
